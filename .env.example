# Postgres. Neon, Supabase and Vercel Postgres all work.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Microsoft Entra ID (Azure AD) app registration.
# Redirect URI to register: <APP_BASE_URL>/api/auth/callback
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""

# Who may sign in and have an account created automatically.
# Comma separated, no @. Anyone else must be added by an admin first.
ALLOWED_EMAIL_DOMAINS="rclick.com"

# Public origin. Leave unset locally; Vercel fills it in from its own vars.
APP_BASE_URL=""

# Which calendar day it is, for opening and closing cycles.
OFFICE_TIMEZONE="America/Los_Angeles"

# Shared secret for the daily cron. Any long random string.
CRON_SECRET=""
