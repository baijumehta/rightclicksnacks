# Postgres. Neon, Supabase and Vercel Postgres all work.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Microsoft Entra ID (Azure AD) app registration.
# Redirect URI to register: <APP_BASE_URL>/api/auth/callback
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""

# Who may sign in and have an account created automatically.
# Comma separated, no @. Anyone else must be added by an admin first.
ALLOWED_EMAIL_DOMAINS="rclick.com"

# Public origin. Leave unset locally; Vercel fills it in from its own vars.
APP_BASE_URL=""

# Which calendar day it is, for opening and closing cycles.
OFFICE_TIMEZONE="America/Los_Angeles"

# Shared secret for the daily cron. Any long random string.
CRON_SECRET=""

# --- Reading a snack off an uploaded photo (optional) ---------------------
# Without a credential the photo box is hidden; the link box and the manual
# form still work. Use ONE of the two options below.
#
# Option A: workload identity federation. Nothing secret is stored -- Vercel
# mints a short-lived OIDC token per deployment and Anthropic trades it for
# access. Create the service account and federation rule in the Claude
# Console, then set these three:
# ANTHROPIC_FEDERATION_RULE_ID="fdrl_..."
# ANTHROPIC_ORGANIZATION_ID="..."
# ANTHROPIC_SERVICE_ACCOUNT_ID="svac_..."
#
# Option B: an API key from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY="sk-ant-api03-..."
#
# Do NOT leave an empty ANTHROPIC_API_KEY set. The SDK treats even a blank
# key as a credential, and it silently outranks federation.
